{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chunk",
  "type": "object",
  "required": [
    "chunk_id", "class", "subject", "stream", "book_title",
    "chapter_no", "chapter_title", "section_title",
    "content_type", "is_figure_dependent", "page_no", "text"
  ],
  "properties": {
    "chunk_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+_[a-z]+_ch[0-9]{2}_s[0-9]{2}_[a-z0-9]+$"
    },
    "class": { "type": "integer", "enum": [9, 10, 11, 12] },
    "subject": { "type": "string", "enum": ["social_science", "english", "hindi", "biology"] },
    "stream": {
      "type": ["string", "null"],
      "enum": ["history", "geography", "civics", "economics", "literature", "grammar", null]
    },
    "book_title": { "type": "string" },
    "chapter_no": { "type": "integer", "minimum": 1 },
    "chapter_title": { "type": "string" },
    "section_title": { "type": "string" },
    "subsection_title": { "type": ["string", "null"] },
    "content_type": {
      "type": "string",
      "enum": ["prose", "box", "timeline", "exercise", "glossary", "source_extract"]
    },
    "is_figure_dependent": { "type": "boolean" },
    "page_no": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}